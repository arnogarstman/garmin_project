# Copy to .env (gitignored). Only the settings you need.

# prod (default): your own Garmin data. demo: a simulated athlete from
# `uv run synthesize`, kept in data/demo/ and safe to publish.
# DATA_PROFILE=prod

# Garmin Connect login. Used by `uv run ingest garmin` and to prefill the
# dashboard login form. Session tokens are cached in GARMIN_TOKEN_DIR.
GARMIN_EMAIL=arno-garstman@live.nl
GARMIN_PASSWORD=Roeters1995@
# GARMIN_TOKEN_DIR=.garmin_tokens

# Enables the AI coach and training plan in the dashboard.
ANTHROPIC_API_KEY=

# Data locations for the prod profile (the demo reads DEMO_<name> instead and
# defaults to data/demo/). Paths are relative to the project root.
# DATABASE holds raw payloads, staging and marts: a local DuckDB file, or a
# MotherDuck database as md:<name> (then set MOTHERDUCK_TOKEN).
# DATABASE=md:garmin
# MOTHERDUCK_TOKEN=
# GOAL_PATH=data/goal.json

# First day of the Dagster daily partitions for real data.
# GARMIN_HISTORY_START=2026-01-01
