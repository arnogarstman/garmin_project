# Copy to .env (gitignored). Only the settings you need.

# Garmin Connect login. Used by `uv run ingest garmin`. Session tokens are cached in
# GARMIN_TOKEN_DIR.
GARMIN_EMAIL=
GARMIN_PASSWORD=
# GARMIN_TOKEN_DIR=.garmin_tokens
# Set to false where a password login must never be tried (the scheduled refresh does):
# without a working saved session the run then fails instead of logging in.
# GARMIN_PASSWORD_LOGIN=true

# Enables the workout reviews (coach source).
ANTHROPIC_API_KEY=

# Data locations. Paths are relative to the project root.
# DATABASE holds raw payloads, staging and marts: a local DuckDB file, or a
# MotherDuck database as md:<name> (then set MOTHERDUCK_TOKEN).
# DATABASE=md:garmin
# MOTHERDUCK_TOKEN=
# GOAL_PATH=data/goal.json

# First day of the Dagster daily partitions for real data.
# GARMIN_HISTORY_START=2026-01-01
