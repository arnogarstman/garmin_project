# Copy this file to secrets.toml (gitignored) to prefill the login form.
# You still have to click "Log in" — nothing here bypasses authentication,
# and Garmin Connect session tokens (not this file) are what's cached
# across app restarts.
garmin_email = "you@example.com"
garmin_password = "your-garmin-password"

# Optional — enables the "AI Coach" synthesis on the Insights tab.
# Get a key at https://console.anthropic.com/
anthropic_api_key = "sk-ant-..."
